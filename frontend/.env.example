# Public site URL (used for metadata, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Backend API (wired up in Step 6; not used while mock data is active)
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# Set to "false" to hide the demo-content notice once real hotel data is entered
NEXT_PUBLIC_DEMO_MODE=true

# Where the Express API runs. Next.js proxies /api/* to it (used by the admin panel).
BACKEND_URL=http://localhost:5000
# Must match the backend COOKIE_NAME (used by the /admin route guard)
ADMIN_COOKIE_NAME=sh_token

# Instant refresh after admin edits: must equal REVALIDATE_SECRET in the backend env (>= 16 chars). Optional.
# REVALIDATE_SECRET=
# Offline development without the backend: show built-in demo data
# NEXT_PUBLIC_USE_MOCK=false
